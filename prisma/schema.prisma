generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model User {
  id              String              @id @default(cuid())
  name            String              @db.VarChar(120)
  email           String              @unique @db.VarChar(254)
  passwordHash    String
  emailVerifiedAt DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  sessions        Session[]
  tokens          VerificationToken[]
  lists           TodoList[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique @db.Char(64)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?  @db.VarChar(500)
  ipAddress String?  @db.VarChar(64)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model VerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique @db.Char(64)
  type      TokenType
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

model RateLimitEvent {
  id        String   @id @default(cuid())
  action    String   @db.VarChar(40)
  keyHash   String   @db.Char(64)
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([action, keyHash, createdAt])
}

model TodoList {
  id        String     @id @default(cuid())
  name      String     @db.VarChar(120)
  userId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks     TodoItem[]

  @@index([userId, updatedAt])
}

model TodoItem {
  id          String    @id @default(cuid())
  title       String    @db.VarChar(240)
  description String?   @db.VarChar(2000)
  completed   Boolean   @default(false)
  dueDate     DateTime?
  priority    Priority  @default(MEDIUM)
  listId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  list        TodoList  @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([listId, completed, dueDate])
}
